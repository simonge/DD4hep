<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example Geant4 simulation configuration using run metadata
  
  This example shows how to use the Geant4RunMetadata action which reads
  metadata configuration from the detector description (set up by the
  DD4hep_RunMetadata plugin) and applies it to the output files.
  
  The metadata is configured in the compact detector XML file using the
  DD4hep_RunMetadata plugin. This Geant4 setup file just needs to include
  the Geant4RunMetadata action in the RunAction phase.
-->
<geant4_setup>
  
  <!-- Kernel parameters -->
  <kernel UI="" NumEvents="10" />
  
  <!-- List of globally known actions -->
  <actions>
    <!-- Action to apply metadata from detector description -->
    <action name="Geant4RunMetadata/RunMetadata"/>
  </actions>
  
  <!-- List of known phases -->
  <phases>
    <phase type="RunAction/begin">
      <!-- Add the metadata action to automatically apply configured metadata -->
      <action name="RunMetadata"/>
    </phase>
  </phases>
  
  <!-- Example generator and output configuration -->
  <sequences>
    <sequence name="Geant4GeneratorActionSequence/GeneratorAction">
      <action name="Geant4ParticleGun/Gun">
        <properties energy="10*GeV" particle="'e-'" multiplicity="1"/>
      </action>
      <action name="Geant4PrimaryHandler/PrimaryHandler"/>
    </sequence>
    
    <sequence name="Geant4EventActionSequence/EventAction">
      <!-- Example: EDM4hep output will include the metadata -->
      <!-- <action name="Geant4Output2EDM4hep/EDM4hepOutput"> -->
      <!--   <properties Output="output.root"/> -->
      <!-- </action> -->
    </sequence>
  </sequences>
  
</geant4_setup>
